					<ownedRule xmi:type='uml:Constraint' xmi:id='_12_0_8f90291_1163122599062_7981_388' name='Not Abstract Classifier'>
						<constrainedElement xmi:idref='_9_0_62a020a_1105704884755_923432_7717'/>
						<ownedComment xmi:type='uml:Comment' xmi:id='_12_0_8f90291_1163122660390_153460_390' body='If at least one operation is abstract implies that classifier is abstract'>
							<annotatedElement xmi:idref='_12_0_8f90291_1163122599062_7981_388'/>
						</ownedComment>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_12_0_8f90291_1163122630109_431704_389'>
							<body>isAbstract implies owner.oclAsType(Classifier).isAbstract</body>
							<language>OCL2.0</language>
						</specification>
					</ownedRule>
					<ownedRule xmi:type='uml:Constraint' xmi:id='_12_0_8f90291_1163188975562_203783_287' name='Not Public Interface Feature'>
						<constrainedElement xmi:idref='_9_0_62a020a_1105704884649_358727_7668'/>
						<ownedComment xmi:type='uml:Comment' xmi:id='_12_0_8f90291_1163189140796_541803_292' body='All the features in the interface should be public'>
							<annotatedElement xmi:idref='_12_0_8f90291_1163188975562_203783_287'/>
						</ownedComment>
						<specification xmi:type='uml:OpaqueExpression' xmi:id='_12_0_8f90291_1163189049250_212710_288'>
							<body>ownedAttribute-&gt;forAll( f | f.visibility=VisibilityKind::public ) and ownedOperation-&gt;forAll(a |a.visibility=VisibilityKind::public )</body>
							<language>OCL2.0</language>
						</specification>
					</ownedRule>
