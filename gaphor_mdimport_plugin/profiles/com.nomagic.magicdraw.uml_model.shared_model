        &lt;argument xsi:type=&quot;lookupExpressionSpecification&quot; symbol=&quot;THIS&quot;/&gt;
        &lt;expression xsi:type=&quot;tagExpressionSpecification&quot; direction=&quot;DIRECT&quot; includeCustomTypes=&quot;false&quot; includeSubtypes=&quot;true&quot;&gt;
            &lt;tag xsi:type=&quot;tag&quot; tagId=&quot;_2021x_1_30d0125_1605090701534_976053_1273&quot; derived=&quot;false&quot;&gt;
                &lt;property stereotypeId=&quot;_17_0_5beta_f720368_1373961709543_89140_3280&quot;&gt;
                    &lt;propertyValue xsi:type=&quot;tagId&quot; value=&quot;_2021x_1_30d0125_1605090701534_976053_1273&quot;/&gt;
