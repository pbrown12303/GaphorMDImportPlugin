			</ownedComment>
			<ownedRule xmi:type='uml:Constraint' xmi:id='magicdraw_1045467100313_593398_14' name='xor'>
				<ownedComment xmi:type='uml:Comment' xmi:id='magicdraw_1045467100323_439010_48' body='The {xor} constraint is applied to a set of associations, specifying that&#10;over that set, exactly one is manifest for each associated instance. Xor is&#10;an exclusive or (not inclusive or) constraint.'>
					<annotatedElement xmi:idref='magicdraw_1045467100313_593398_14'/>
				</ownedComment>
				<specification xmi:type='uml:OpaqueExpression' xmi:id='mindis_1054797479834_206585_3'>
					<body>xor</body>
				</specification>
			</ownedRule>
