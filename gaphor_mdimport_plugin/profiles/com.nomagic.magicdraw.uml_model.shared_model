			<packagedElement xmi:type='uml:Package' xmi:id='_12_0EAPbeta_be00301_1157529392394_202602_1' name='PrimitiveTypes' URI='http://www.omg.org/spec/PrimitiveTypes/20100901'>
				<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_9_0_2_91a0295_1110274713995_297054_0' name='String'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_12_0EAPbeta_be00301_1157547404043_716642_757' body='An instance of String defines a piece of text. The semantics of the string itself depends on its purpose, it can be a comment, computational language expression, OCL expression, etc. It is used for String attributes and String expressions in the metamodel.'>
						<annotatedElement xmi:idref='_9_0_2_91a0295_1110274713995_297054_0'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_12_0EAPbeta_be00301_1157529809864_59216_12' name='UnlimitedNatural'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_12_0EAPbeta_be00301_1157547442388_987546_758' body='An instance of UnlimitedNatural is an element in the (infinite) set of naturals (0, 1, 2…). The value of infinity is shown&#10;using an asterisk (‘*’).'>
						<annotatedElement xmi:idref='_12_0EAPbeta_be00301_1157529809864_59216_12'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_17_0beta_f720368_1291217394082_340077_1886' name='Real'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_17_0beta_f720368_1291217535405_442239_1887' body='A real is a primitive type representing the mathematical concept of real.'>
						<annotatedElement xmi:idref='_17_0beta_f720368_1291217394082_340077_1886'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:PrimitiveType' xmi:id='donce_1051693917650_319078_0' name='Integer'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_12_0EAPbeta_be00301_1157547395471_223999_756' body='An instance of Integer is an element in the (infinite) set of integers (…-2, -1, 0, 1, 2…). It is used for integer attributes and integer expressions in the metamodel.'>
						<annotatedElement xmi:idref='donce_1051693917650_319078_0'/>
					</ownedComment>
				</packagedElement>
				<packagedElement xmi:type='uml:PrimitiveType' xmi:id='_12_0EAPbeta_be00301_1157529792739_987548_11' name='Boolean'>
					<ownedComment xmi:type='uml:Comment' xmi:id='_12_0EAPbeta_be00301_1157547385336_610735_755' body='Boolean is an instance of PrimitiveType. In the metamodel, Boolean defines an enumeration that denotes a logical condition. &#10;Its enumeration literals are:&#10;• true - The Boolean condition is satisfied. &#10;• false - The Boolean condition is not satisfied. &#10;&#10;It is used for Boolean attribute and Boolean expressions in the metamodel, such as OCL expression. &#10;'>
						<annotatedElement xmi:idref='_12_0EAPbeta_be00301_1157529792739_987548_11'/>
					</ownedComment>
				</packagedElement>
			</packagedElement>
