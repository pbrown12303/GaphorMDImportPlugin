				<ownedRule xmi:type='uml:Constraint' xmi:id='_18_3beta_8ba0279_1435646945178_262982_4075' name='Element not in diagram'>
					<constrainedElement xmi:idref='_9_0_62a020a_1106296071977_61607_0'/>
					<ownedComment xmi:type='uml:Comment' xmi:id='_18_3beta_8ba0279_1441204866408_832964_4227' body='If an element and a diagram have the same owner (behavior context), the element must be displayed on that diagram pane. If there are several diagrams under the same owner, the element must be displayed at least in one of them. This rule applies for Sequence, Activity, State Machine, and Communication diagrams.'>
