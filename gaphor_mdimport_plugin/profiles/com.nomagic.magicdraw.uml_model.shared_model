						<defaultValue xmi:type='uml:LiteralBoolean' xmi:id='_16_8beta_8f90291_1257409433754_523426_353' value='true'/>
					</ownedAttribute>
					<ownedAttribute xmi:type='uml:Property' xmi:id='_17_0_2_8f90291_1338982303822_462113_2113' name='base_Property' visibility='private' type='_9_0_62a020a_1105704884574_96724_7644' association='_17_0_2_8f90291_1338982303822_318657_2112'/>
