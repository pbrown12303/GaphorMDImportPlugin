	<uml:Package xmi:type='uml:Package' xmi:id='magicdraw_uml_standard_profile_v_0001' name='UML Standard Profile'>
		<ownedComment xmi:type='uml:Comment' xmi:id='_be00301_1078843546940_242228_131' body='UML Standard Profile contains a UML metamodel (metaclasses without properties and associations), Standard UML stereotypes defined in the annex C of UML specification, validation suites for UML model correctness and completeness checking, and stereotypes used by MagicDraw internally.'>
			<annotatedElement xmi:idref='magicdraw_uml_standard_profile_v_0001'/>
		</ownedComment>
		<packagedElement xmi:type='uml:Profile' xmi:id='_be00301_1073394351331_445580_2' name='MagicDraw Profile' URI='http://www.omg.org/spec/UML/20131001/MagicDrawProfile'>
