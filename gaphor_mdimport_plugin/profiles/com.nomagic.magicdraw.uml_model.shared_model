				<ownedAttribute xmi:type='uml:Property' xmi:id='_10_0EAPbeta_be00301_1123081771437_691692_123' name='base_Artifact' visibility='private' type='_9_0_62a020a_1105704928546_39588_9532' association='_10_0EAPbeta_be00301_1123081771437_9842_122'/>
