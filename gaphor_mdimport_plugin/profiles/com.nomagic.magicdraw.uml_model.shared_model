			<packagedElement xmi:type='uml:Stereotype' xmi:id='magicdraw_1046861421226_787534_7' name='Send'>
				<ownedComment xmi:type='uml:Comment' xmi:id='magicdraw_1046861429848_229749_95' body='A usage dependency whose source is an operation and&#10;whose target is a signal, specifying that the source sends the&#10;target signal.'>
